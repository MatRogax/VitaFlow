@namespace projeto_carlos.Components.UI

<header class="flex items-center justify-between bg-transparent px-6 md:px-20 py-8 sticky top-0 z-50">
    <div class="flex items-center gap-3">
        <div class="text-white bg-primary flex items-center justify-center w-12 h-12 rounded-xl shadow-lg shadow-primary/20">
            <span class="material-symbols-outlined text-[28px] font-bold">psychology</span>
        </div>
        <h2 class="text-[1.35rem] font-bold tracking-tight text-slate-800">VitaFlow</h2>
    </div>

    @if (RightContent != null)
    {
        <div class="flex items-center">
            @RightContent
        </div>
    }
</header>

@code {
    [Parameter] 
    public RenderFragment? RightContent { get; set; }
}