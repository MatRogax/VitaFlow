@using projeto_carlos.Models.Entities

<div class="p-5 hover:bg-slate-50 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-4">
        @if (!string.IsNullOrEmpty(Session.Psychologist.ImageUrl))
        {
            <img src="@Session.Psychologist.ImageUrl" 
                 alt="@Session.Psychologist.Name" 
                 class="w-12 h-12 rounded-full object-cover grayscale opacity-60" />
        }
        else
        {
            <div class="w-12 h-12 rounded-full @Session.Psychologist.Avatar flex items-center justify-center text-white text-md font-bold grayscale opacity-60">
                @GetInitials(Session.Psychologist.Name)
            </div>
        }
        <div>
            <h5 class="font-bold text-slate-800">@Session.Psychologist.Name</h5>
            <p class="text-sm text-slate-500">@Session.Psychologist.Specialty</p>
        </div>
    </div>
    
    <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-center text-sm text-slate-500 gap-2 sm:gap-1">
        <span class="font-medium text-slate-700">@Session.Date.ToString("MMM dd, yyyy")</span>
        <span>@Session.Status</span>
    </div>
    
    <button class="text-primary font-bold text-sm hover:underline flex items-center gap-1 justify-end transition-all">
        View Notes <span class="material-symbols-outlined text-[18px]">chevron_right</span>
    </button>
</div>

@code {
    [Parameter, EditorRequired]
    public SessionModel Session { get; set; } = default!;

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var realName = parts.Where(p => !p.StartsWith("Dr")).ToArray();
        if (realName.Length == 0) return "";
        if (realName.Length == 1) return realName[0].Substring(0, 1).ToUpper();
        return (realName[0].Substring(0, 1) + realName[1].Substring(0, 1)).ToUpper();
    }
}
