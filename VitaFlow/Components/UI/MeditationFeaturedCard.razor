@using projeto_carlos.Models
@namespace projeto_carlos.Components.UI

<div class="lg:col-span-2 relative rounded-[2.5rem] overflow-hidden group shadow-xl shadow-slate-200/50 bg-slate-900 isolate min-h-[400px]">
    <img src="@Meditation.ImageUrl" 
         class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:scale-105 transition-transform duration-1000 ease-out -z-10" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/20 to-transparent -z-10"></div>
    
    <div class="absolute inset-0 p-10 flex flex-col justify-end">
        <div class="flex items-center gap-3 mb-6">
            <span class="px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-bold uppercase tracking-widest leading-none outline outline-1 outline-white/30">
                Featured
            </span>
            <span class="px-4 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-bold flex items-center gap-1.5 leading-none outline outline-1 outline-white/30">
                <span class="material-symbols-outlined text-[14px]">schedule</span> 
                @Meditation.DurationMinutes min
            </span>
        </div>
        
        <h3 class="text-[2.25rem] font-black text-white tracking-tight mb-4 group-hover:translate-x-2 transition-transform duration-500 leading-none">
            @Meditation.Title
        </h3>
        
        <p class="text-white/80 text-lg max-w-lg mb-8 line-clamp-2 leading-relaxed font-medium">
            @Meditation.Description
        </p>
        
        <button class="w-fit flex items-center gap-3 px-8 py-4 rounded-full bg-white text-slate-900 font-bold hover:bg-slate-100 transition-all shadow-lg active:scale-95">
            <span class="material-symbols-outlined fill-1">play_arrow</span>
            <span>Listen Now</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public Meditation Meditation { get; set; } = new();
}
