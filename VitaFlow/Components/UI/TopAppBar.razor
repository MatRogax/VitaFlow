@namespace projeto_carlos.Components.UI

<header class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12">
    <div class="flex items-center gap-8 group">
        <button class="text-sm font-bold uppercase tracking-[0.2em] @(ActiveTab == "Focus" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-400 hover:text-primary transition-colors")" 
                @onclick="@(() => SetTab("Focus"))">
            Focus
        </button>
        <button class="text-sm font-bold uppercase tracking-[0.2em] @(ActiveTab == "Relief" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-400 hover:text-primary transition-colors")"
                @onclick="@(() => SetTab("Relief"))">
            Relief
        </button>
        <button class="text-sm font-bold uppercase tracking-[0.2em] @(ActiveTab == "Sleep" ? "text-primary border-b-2 border-primary pb-1" : "text-slate-400 hover:text-primary transition-colors")"
                @onclick="@(() => SetTab("Sleep"))">
            Sleep
        </button>
    </div>
    <div class="flex items-center gap-6 w-full md:w-auto">
        <div class="relative flex-1 md:w-64">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl">search</span>
            <input type="text" 
                   placeholder="Search meditations..." 
                   class="w-full pl-12 pr-4 py-3 bg-white border border-slate-200 rounded-full text-sm outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all shadow-sm" />
        </div>
        <div class="flex items-center gap-4">
            <button class="text-slate-400 hover:text-primary transition-colors">
                <span class="material-symbols-outlined">notifications</span>
            </button>
        </div>
    </div>
</header>

@code {
    [Parameter] public string ActiveTab { get; set; } = "Focus";
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }

    private async Task SetTab(string tab)
    {
        ActiveTab = tab;
        await OnTabChanged.InvokeAsync(tab);
    }
}
