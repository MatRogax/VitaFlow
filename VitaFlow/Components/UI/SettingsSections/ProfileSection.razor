@using projeto_carlos.Components.UI
@using projeto_carlos.Services
@using projeto_carlos.Enums
@inject UserSessionService SessionService

<div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-sm border border-slate-200 animate-fade-in">
    <div class="flex flex-col md:flex-row items-center gap-10 mb-12 pb-10 border-b border-slate-100">
        <div class="relative group">
            <div class="w-32 h-32 rounded-full bg-slate-100 border-4 border-white shadow-xl flex items-center justify-center overflow-hidden">
                @if (SessionService.IsLoggedIn)
                {
                    <span class="text-4xl font-black text-primary">@SessionService.CurrentUser?.Name[0]</span>
                }
                else
                {
                    <span class="material-symbols-outlined text-4xl text-slate-300">person</span>
                }
            </div>
            <button class="absolute bottom-1 right-1 bg-white p-2.5 rounded-full shadow-lg border border-slate-100 text-primary hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-xl">photo_camera</span>
            </button>
        </div>
        <div class="flex-1 text-center md:text-left">
            <h3 class="text-2xl font-black text-slate-900 mb-1">@SessionService.CurrentUser?.Name</h3>
            <p class="text-slate-500 font-medium tracking-tight">Paciente desde @SessionService.CurrentUser?.CreatedAt.ToString("MMMM yyyy")</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl">
        <Input 
            Label="Nome Completo" 
            Value="@SessionService.CurrentUser?.Name" 
            ReadOnly="true" />
            
        <Input 
            Label="E-mail" 
            Value="@SessionService.CurrentUser?.Email" 
            ReadOnly="true" />

        <div class="md:col-span-2 mt-4">
            <Button Variant="EButtonVariant.Primary" CssClass="px-10 h-14 shadow-lg shadow-primary/20">
                Salvar Alterações
            </Button>
        </div>
    </div>
</div>
