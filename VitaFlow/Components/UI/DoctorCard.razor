@using projeto_carlos.Enums
@using projeto_carlos.Models.Entities

<div class="bg-white rounded-[2rem] p-8 flex flex-col shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 group">
    
    <div class="flex items-start gap-4 mb-6">
        <div class="relative flex-shrink-0">
            @if (!string.IsNullOrEmpty(Psychologist.ImageUrl))
            {
                <img src="@Psychologist.ImageUrl" 
                     alt="@Psychologist.Name" 
                     class="w-16 h-16 rounded-full object-cover border-2 border-slate-50 shadow-sm" />
            }
            else
            {
                <div class="w-16 h-16 rounded-full @Psychologist.Avatar flex items-center justify-center text-white text-xl font-bold border-2 border-slate-50 shadow-sm">
                    @GetInitials(Psychologist.Name)
                </div>
            }
            <div class="absolute bottom-0 right-0 w-4 h-4 bg-green-500 border-2 border-white rounded-full"></div>
        </div>

        <div class="flex-1 min-w-0">
            <h3 class="font-bold text-slate-900 text-lg leading-tight truncate">@Psychologist.Name</h3>
            <p class="text-sm text-slate-500 font-medium mt-1 truncate">@Psychologist.Specialty</p>
            
            <div class="flex items-center gap-1 mt-2">
                <div class="flex">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="material-symbols-outlined text-sm @(i <= Psychologist.Note ? "text-yellow-400" : "text-slate-200")" 
                              style="font-variation-settings: 'FILL' 1;">star</span>
                    }
                </div>
                <span class="text-[11px] font-bold text-slate-400">(@Psychologist.Note.ToString("0.0"))</span>
            </div>
        </div>
    </div>

    @if (Psychologist.Tags.Any())
    {
        <div class="flex flex-wrap gap-2 mb-8">
            @foreach (var tag in Psychologist.Tags)
            {
                <span class="bg-slate-50 text-slate-500 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                    @tag
                </span>
            }
        </div>
    }

    <div class="mt-auto">
        <Button Variant="EButtonVariant.Outline" 
                CssClass="w-full !bg-blue-50/30 !text-primary !border-none !py-4 hover:!bg-primary hover:!text-white transition-all shadow-none font-bold text-sm rounded-2xl" 
                OnClick="OnScheduleClick">
            Agendar Sessão
        </Button>
    </div>
</div>

@code {

    [Parameter, EditorRequired] 
    public PsychologistModel Psychologist { get; set; } = default!;
    
    [Parameter] 
    public EventCallback<int> OnSchedule { get; set; }

    private async Task OnScheduleClick()
    {
        if (OnSchedule.HasDelegate)
        {
            await OnSchedule.InvokeAsync(Psychologist.Id); 
        }
    }
    
    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var realName = parts.Where(p => !p.StartsWith("Dr")).ToArray();
        if (realName.Length == 0) return "";
        if (realName.Length == 1) return realName[0].Substring(0, 1).ToUpper();
        return (realName[0].Substring(0, 1) + realName[1].Substring(0, 1)).ToUpper();
    }
}