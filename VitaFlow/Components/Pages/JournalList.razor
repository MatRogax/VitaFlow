@page "/diario"
@using projeto_carlos.Models
@using projeto_carlos.Services
@using projeto_carlos.Components.UI
@inject IJournalService JournalService
@inject NavigationManager NavManager

<main class="flex-1 flex flex-col h-full overflow-hidden bg-slate-50 dark:bg-slate-950/20">
    <header class="sticky top-0 z-10 bg-slate-50/80 dark:bg-background-dark/80 backdrop-blur-md p-8 pb-4">
        <div class="max-w-[1920px] mx-auto flex flex-col gap-6">
            <div class="flex justify-between items-end">
                <div class="flex flex-col gap-1">
                    <h2 class="text-slate-900 dark:text-white text-3xl font-black tracking-tight leading-tight">Meu Diário e Evolução</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">Acompanhe sua jornada e sentimentos ao longo do tempo.</p>
                </div>
                <button @onclick="GoToNew" class="hidden md:flex bg-primary hover:bg-primary/90 text-white rounded-xl py-3 px-6 items-center justify-center gap-2 font-bold text-sm transition-all shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-sm">add</span>
                    <span>Novo Registro</span>
                </button>
            </div>
            
            <div class="flex items-center gap-3 overflow-x-auto pb-2 scrollbar-hide">
                <DiaryFilter Label="Últimos 7 dias" IsActive="true" />
                <DiaryFilter Label="Este mês" />
                <DiaryFilter Label="Últimos 3 meses" />
                <DiaryFilter Label="Personalizado" Icon="calendar_today" HasArrow="false" />
            </div>
        </div>
    </header>

    <section class="flex-1 p-8 pt-4 overflow-y-auto">
        <div class="max-w-[1920px] mx-auto space-y-6">
            @if (!Entries.Any())
            {
                <JournalEmptyState OnNewEntry="GoToNew" />
            }
            else
            {
                @foreach (var entry in Entries)
                {
                    <JournalEntryCard Entry="entry" />
                }
            }

            @if (Entries.Any())
            {
                <div class="flex justify-center py-6">
                    <button class="flex items-center gap-2 text-slate-500 dark:text-slate-400 font-bold text-sm hover:text-primary transition-colors">
                        <span class="material-symbols-outlined">expand_more</span>
                        Carregar registros anteriores
                    </button>
                </div>
            }
        </div>
    </section>
</main>

