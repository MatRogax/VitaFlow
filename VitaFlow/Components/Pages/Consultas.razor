@page "/consultas"
@using projeto_carlos.Models.Entities
@using projeto_carlos.Components.UI
@using projeto_carlos.Enums

@inject NavigationManager NavManager

<div class="px-6 md:px-20 py-10 w-full max-w-[1920px] mx-auto flex flex-col">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
            <h2 class="text-[36px] leading-tight font-extrabold tracking-tight text-slate-900 mb-2 font-headline">Your Sessions</h2>
            <p class="text-[18px] text-slate-500 font-body">Manage your upcoming check-ins and review past guidance.</p>
        </div>
        <Button Variant="EButtonVariant.Outline" 
                OnClick="@(() => NavManager.NavigateTo("/psicologos"))"
                CssClass="bg-white text-primary border-slate-200 shadow-sm hover:shadow-md py-3 px-6 whitespace-nowrap group">
            <span class="material-symbols-outlined text-[20px] mr-2 group-hover:rotate-90 transition-transform">add</span>
            Schedule New Session
        </Button>
    </div>
    <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
            </div>
            <h3 class="text-[20px] font-bold text-slate-800 tracking-tight">Upcoming Sessions</h3>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            @foreach (var session in UpcomingSessions)
            {
                <AppointmentCard Session="session" OnJoin="HandleJoinSession" />
            }
        </div>
    </section>
    <section>
        <div class="flex items-center gap-3 mb-6">
            <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500">
                <span class="material-symbols-outlined text-[18px]">history</span>
            </div>
            <h3 class="text-[20px] font-bold text-slate-800 tracking-tight">Past Sessions</h3>
        </div>
        
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="divide-y divide-slate-100">
                @foreach (var session in PastSessions)
                {
                    <AppointmentItem Session="session" />
                }
            </div>
            <div class="p-4 bg-slate-50 border-t border-slate-100 text-center">
                <button class="text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors">
                    Load More History
                </button>
            </div>
        </div>
    </section>
</div>

