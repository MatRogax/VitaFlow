@page "/configuracoes"
@using projeto_carlos.Components.UI
@using projeto_carlos.Components.UI.SettingsSections
@using projeto_carlos.Enums
@inject NavigationManager NavManager

<div class="px-6 md:px-20 py-10 w-full max-w-[1920px] mx-auto flex flex-col gap-10">
    <div class="flex flex-col gap-2">
        <h1 class="text-4xl font-black text-slate-900 tracking-tight">Configurações</h1>
        <p class="text-slate-500 font-medium tracking-tight">Gerencie sua conta, notificações e preferências de privacidade.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <nav class="lg:col-span-3 flex flex-row lg:flex-col gap-3 overflow-x-auto pb-4 lg:pb-0">
            @foreach (var item in Enum.GetValues<ESettingsSection>())
            {
                var isSelected = _activeSection == item;
                <button @onclick="@(() => _activeSection = item)" 
                        class="flex items-center gap-4 px-6 py-4 rounded-2xl transition-all duration-300 font-bold text-sm whitespace-nowrap
                               @(isSelected ? "bg-white shadow-md text-primary" : "text-slate-500 hover:bg-white/50")">
                    <span class="material-symbols-outlined @(isSelected ? "text-primary" : "text-slate-400")">@item.ToIcon()</span>
                    <span>@item.ToDisplayName()</span>
                </button>
            }
        </nav>
        <div class="lg:col-span-9 space-y-8">
            @switch (_activeSection)
            {
                case ESettingsSection.Perfil:
                    <ProfileSection />
                    break;
                case ESettingsSection.Notifications:
                    <NotificationsSection />
                    break;
                case ESettingsSection.Security:
                    <SecuritySection />
                    break;
                case ESettingsSection.Privacy:
                    <PrivacySection />
                    break;
            }
        </div>
    </div>
</div>

@code {
    private ESettingsSection _activeSection = ESettingsSection.Perfil;
}
