@page "/dashboard"
@using projeto_carlos.Components.UI
@using projeto_carlos.Enums
@using projeto_carlos.Services
@using projeto_carlos.Services.Interfaces
@using projeto_carlos.Models.Entities

@inject UserSessionService SessionService
@inject NavigationManager NavManager
@inject IAppointmentService AppointmentService
@inject IJournalService JournalService

@if (!SessionService.IsLoggedIn)
{
    <div class="flex items-center justify-center min-h-[60vh]">
        <div class="text-center">
            <div class="w-16 h-16 border-4 border-primary border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
            <p class="text-slate-500 font-medium">Redirecionando para o login...</p>
        </div>
    </div>
}
else
{
    <div class="px-6 md:px-20 py-10 w-full max-w-[1920px] mx-auto flex flex-col gap-12 animate-fade-in">
        <div class="flex flex-col gap-2 mb-4">
            <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-none">
                Como você está se sentindo hoje, <span class="text-primary tracking-normal">@SessionService.CurrentUser?.Name.Split(' ')[0]</span>?
            </h1>
            <p class="text-slate-500 text-lg font-medium">
                Estamos aqui para cuidar de você e do seu bem-estar mental.
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div @onclick="@(() => NavManager.NavigateTo("/journal/create"))" class="bg-white rounded-3xl p-8 flex flex-col shadow-sm border border-slate-200 hover:shadow-md transition-all cursor-pointer group">
                <div class="w-14 h-14 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-3xl">mood</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">Registrar Humor</h3>
                <p class="text-slate-500 text-sm leading-relaxed flex-1 mb-6">
                    Acompanhe suas emoções e identifique padrões ao longo da semana.
                </p>
                <div class="text-primary font-bold text-sm flex items-center gap-1 group-hover:underline">
                    Iniciar agora <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </div>
            </div>
            
            <div @onclick="@(() => NavManager.NavigateTo("/psicologos"))" class="bg-white rounded-3xl p-8 flex flex-col shadow-sm border border-slate-200 hover:shadow-md transition-all cursor-pointer group">
                <div class="w-14 h-14 rounded-full bg-purple-50 text-purple-500 flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-3xl">psychology</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">Buscar Psicólogo</h3>
                <p class="text-slate-500 text-sm leading-relaxed flex-1 mb-6">
                    Encontre o profissional ideal para suas necessidades e agende uma conversa.
                </p>
                <div class="text-purple-600 font-bold text-sm flex items-center gap-1 group-hover:underline">
                    Ver especialistas <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </div>
            </div>
            
            <div @onclick="@(() => NavManager.NavigateTo("/meditacoes"))" class="bg-white rounded-3xl p-8 flex flex-col shadow-sm border border-slate-200 hover:shadow-md transition-all cursor-pointer group">
                <div class="w-14 h-14 rounded-full bg-green-50 text-green-500 flex items-center justify-center mb-6">
                    <span class="material-symbols-outlined text-3xl">headphones</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3">Ouvir Meditação</h3>
                <p class="text-slate-500 text-sm leading-relaxed flex-1 mb-6">
                    Pratique mindfulness com sessões guiadas para reduzir o estresse.
                </p>
                <div class="text-green-600 font-bold text-sm flex items-center gap-1 group-hover:underline">
                    Explorar áudios <span class="material-symbols-outlined text-base group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 mt-4">
            <div class="lg:col-span-2 flex flex-col gap-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-slate-800">Próxima Consulta</h2>
                    <a href="/consultas" class="text-sm font-bold text-primary hover:underline">Ver todas</a>
                </div>

                @if (_nextAppointment != null)
                {
                    <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center gap-5 hover:border-primary/30 transition-colors">
                        <img src="@(_nextAppointment.Psychologist.ImageUrl ?? "https://i.pravatar.cc/150?u=" + _nextAppointment.PsychologistId)" alt="Dr(a)" class="w-16 h-16 rounded-full object-cover border-2 border-slate-100" />
                        <div class="flex-1 text-center sm:text-left">
                            <h4 class="text-lg font-bold text-slate-800">Sessão com @_nextAppointment.Psychologist.Name</h4>
                            <p class="text-sm text-slate-500 mb-1">@_nextAppointment.Psychologist.Specialty</p>
                            <div class="flex items-center justify-center sm:justify-start gap-1 text-xs font-bold text-primary uppercase tracking-wider">
                                <span class="material-symbols-outlined text-[14px]">calendar_today</span>
                                @_nextAppointment.Date.ToString("dd/MM") às @_nextAppointment.StartTime.ToString(@"hh\:mm")
                            </div>
                        </div>
                        <Button Variant="EButtonVariant.Primary" CssClass="!py-2.5 !px-6 rounded-2xl w-full sm:w-auto shadow-none">
                            Entrar
                        </Button>
                    </div>
                }
                else
                {
                    <div class="bg-slate-50 rounded-3xl p-10 border-2 border-dashed border-slate-200 flex flex-col items-center justify-center text-center">
                        <span class="material-symbols-outlined text-4xl text-slate-300 mb-3">calendar_month</span>
                        <p class="text-slate-500 font-medium mb-4">Você não possui consultas agendadas.</p>
                        <Button Variant="EButtonVariant.Outline" OnClick="@(() => NavManager.NavigateTo("/psicologos"))" CssClass="text-xs font-bold">
                            Agendar Agora
                        </Button>
                    </div>
                }
            </div>

            <div class="lg:col-span-1 flex flex-col gap-6">
                <h2 class="text-2xl font-bold text-slate-800">Seu Diário</h2>
                <div class="bg-primary rounded-[2rem] p-8 text-white shadow-xl shadow-blue-500/30 relative overflow-hidden">
                    <span class="material-symbols-outlined absolute top-8 right-8 text-white/30 text-5xl font-light">auto_stories</span>
                    <p class="text-sm font-medium text-white/80 mb-1">Registros totais</p>
                    <h3 class="text-[2.5rem] font-bold leading-none mb-8">@_journalCount</h3>
                    
                    <div class="mb-5">
                        <div class="flex justify-between text-sm font-semibold mb-2">
                            <span>Continuidade</span>
                            <span>@(_journalCount > 0 ? "70%" : "0%")</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-white/20">
                            <div class="h-full rounded-full bg-white @(_journalCount > 0 ? "w-[70%]" : "w-0")"></div>
                        </div>
                    </div>
                    <p class="text-[0.65rem] italic text-white/80 leading-relaxed font-medium">
                        @( _journalCount > 0 ? "\"Escrever ajuda a processar sentimentos. Continue registrando seu dia!\"" : "\"Comece a registrar seu humor para acompanhar sua evolução.\"" )
                    </p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private Appointment? _nextAppointment;
    private int _journalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!SessionService.IsLoggedIn)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        var userId = SessionService.CurrentUser!.Id;

        // Fetch user data
        var appointments = await AppointmentService.GetAllAsync();
        _nextAppointment = appointments
            .Where(a => a.PatientId == userId && !a.IsCompleted && a.Date.Date >= DateTime.Today)
            .OrderBy(a => a.Date)
            .ThenBy(a => a.StartTime)
            .FirstOrDefault();

        var journals = await JournalService.GetAllAsync();
        _journalCount = journals.Count(j => j.UserId == userId);
    }
}
