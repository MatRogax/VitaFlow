@page "/psicologos"
@using projeto_carlos.Components.UI
@using projeto_carlos.Models.Entities
@using projeto_carlos.Enums
@inject NavigationManager NavManager

<div class="px-6 md:px-20 py-10 w-full max-w-[1920px] mx-auto flex flex-col gap-12">

    <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-6">
            Encontre o apoio ideal <span class="text-primary italic">para você</span>.
        </h1>
        <p class="text-lg text-slate-500 font-medium leading-relaxed">
            Conecte-se com psicólogos voluntários prontos para ajudar na sua jornada de autoconhecimento e bem-estar emocional.
        </p>
    </div>

    <div class="bg-white rounded-3xl p-4 shadow-sm border border-slate-100 flex flex-col lg:flex-row items-center gap-4">
        <div class="flex-1 w-full relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
            <input type="text" 
                   placeholder="Buscar por nome ou área..." 
                   class="w-full pl-12 pr-4 py-4 bg-slate-50 border-none rounded-2xl text-sm outline-none focus:ring-2 focus:ring-primary/20 transition-all" />
        </div>
        
        <div class="flex flex-col sm:flex-row w-full lg:w-auto gap-4">
            <div class="relative w-full sm:w-64">
                <select class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl text-sm outline-none appearance-none cursor-pointer">
                    <option>Especialidade</option>
                    <option>Psicologia Clínica</option>
                    <option>TCC</option>
                    <option>Psicanálise</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
            </div>
            
            <div class="relative w-full sm:w-64">
                <select class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl text-sm outline-none appearance-none cursor-pointer">
                    <option>Disponibilidade</option>
                    <option>Manhã</option>
                    <option>Tarde</option>
                    <option>Noite</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_more</span>
            </div>

            <button class="bg-primary text-white p-4 rounded-xl shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all flex items-center justify-center">
                <span class="material-symbols-outlined">filter_list</span>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var psychologist in _psychologists)
        {
            <DoctorCard Psychologist="psychologist" OnSchedule="HandleSchedule" />
        }
    </div>
</div>

